# ==============================================
# 环境变量模板 - 复制为 .env 后填写实际值
# ==============================================

# ========== 服务配置 ==========
APP_NAME=上海旅游智能体
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8001

# ========== 数据库 ==========
# MySQL 示例（推荐）
DATABASE_URL=mysql+pymysql://root:你的密码@localhost:3306/travel_ai?charset=utf8mb4

# SQLite 示例（无需安装数据库，快速体验）
# DATABASE_URL=sqlite:///./data/travel_ai.db

# ========== Redis ==========
# 是否启用 Redis，未启用时使用内存存储对话历史（重启丢失）
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ========== FAISS 向量库 ==========
# 本地文件模式，数据存在 ./data/faiss_index 目录
FAISS_INDEX_PATH=./data/faiss_index
FAISS_INDEX_NAME=travel_knowledge

# ========== 豆包大模型（火山引擎 Ark） ==========
DOUBAO_API_KEY=你的豆包APIKey
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=你的模型端点ID
DOUBAO_LITE_MODEL=doubao-1-5-lite-32k-250115

# ========== 高德地图 API ==========
AMAP_KEY=你的高德地图Key
AMAP_BASE_URL=https://restapi.amap.com

# ========== 嵌入模型 ==========
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu

# ========== 安全配置 ==========
SECRET_KEY=your-secret-key-change-in-production
CORS_ORIGINS=*
