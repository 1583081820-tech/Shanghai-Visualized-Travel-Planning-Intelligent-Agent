# Copy this file to .env before using Docker Compose.

MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_DATABASE=travel_ai
MYSQL_USER=travel
MYSQL_PASSWORD=replace-with-a-strong-app-password
REDIS_PASSWORD=replace-with-a-strong-redis-password

DOUBAO_API_KEY=replace-with-your-volcengine-ark-api-key
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=replace-with-your-model-endpoint-id
DOUBAO_LITE_MODEL=replace-with-your-lite-model-endpoint-id

AMAP_KEY=replace-with-your-amap-web-service-key
VITE_AMAP_WEB_KEY=replace-with-your-domain-restricted-amap-web-key

EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
SECRET_KEY=replace-with-a-random-application-secret
